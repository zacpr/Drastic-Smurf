import { ScrollView } from "std-widgets.slint";
import { ScreenHeader } from "common.slint";

export struct BackupRow {
    repository: string,
    snapshot-name: string,
    state: string,
    is-current: bool,
    progress-ratio: float,
    progress-label: string,
    processed-human: string,
    total-human: string,
    has-byte-stats: bool,
    processed-shards: int,
    total-shards: int,
    start-time-label: string,
}

export struct SlmPolicyRow {
    name: string,
    last-run: string,
    next-run: string,
}

component BackupCard inherits Rectangle {
    in property <BackupRow> b;
    property <color> state-bg-color: b.state == "SUCCESS" ? #1f3a28 : b.state == "IN PROGRESS" ? #1f2e3a : b.state == "FAILED" ? #3a2222 : b.state == "PARTIAL" ? #3a3320 : #262b33;
    property <color> state-fg-color: b.state == "SUCCESS" ? #7fdc9a : b.state == "IN PROGRESS" ? #7fb8ff : b.state == "FAILED" ? #ff9a9a : b.state == "PARTIAL" ? #f5d97f : #ccc;

    background: #181c22;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2a2f38;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text { text: "Repository: " + b.repository; color: #7a828e; font-size: 10.5px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                border-radius: 4px;
                background: b.is-current ? #1f3a28 : #262b33;
                height: 18px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: b.is-current ? "CURRENT BACKUP" : "PREVIOUS BACKUP";
                        color: b.is-current ? #7fdc9a : #999;
                        font-size: 9px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                border-radius: 4px;
                background: root.state-bg-color;
                height: 20px;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text { text: b.state; color: root.state-fg-color; font-size: 10.5px; vertical-alignment: center; }
                }
            }
            Text {
                text: b.snapshot-name;
                color: #ddd;
                font-size: 11.5px;
                font-family: "monospace";
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: "Progress: " + b.progress-label; color: #ddd; font-size: 11px; }
                if b.has-byte-stats: Text { text: b.processed-human + " / " + b.total-human; color: #999; font-size: 11px; }
                if b.total-shards > 0: Text { text: "Shards: " + b.processed-shards + " / " + b.total-shards; color: #999; font-size: 11px; }
            }
            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: #262b33;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0.0, min(1.0, b.progress-ratio));
                    height: parent.height;
                    border-radius: 4px;
                    background: root.state-fg-color;
                }
            }
        }

        Text { text: "Started: " + b.start-time-label; color: #7a828e; font-size: 10px; }
    }
}

export component SnapshotScreen inherits Rectangle {
    in property <[string]> cluster-options: [];
    in-out property <string> active-cluster: "";
    callback active-cluster-changed(string);

    in property <bool> reachable: false;
    in property <string> error: "";
    in property <bool> has-repositories: false;
    in property <string> resolved-repo: "";
    in property <[BackupRow]> backups: [];
    in property <[SlmPolicyRow]> slm-policies: [];
    in property <bool> is-loading: false;

    callback refresh-clicked();

    background: #14181f;

    VerticalLayout {
        ScreenHeader {
            breadcrumb: "Snapshot";
            cluster-options: root.cluster-options;
            active-cluster <=> root.active-cluster;
            active-cluster-changed(v) => { root.active-cluster-changed(v); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 14px;

            HorizontalLayout {
                Text { text: "Snapshot Monitoring"; color: white; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 70px;
                    background: #2d3f52;
                    border-radius: 4px;
                    TouchArea { clicked => { root.refresh-clicked(); } }
                    Text {
                        text: root.is-loading ? "..." : "↻ Refresh";
                        color: #7fc7ff;
                        font-size: 10.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if root.error != "": Text { text: "⚠ " + root.error; color: #ff9a9a; font-size: 12px; wrap: word-wrap; }

            if root.reachable && root.error == "" && !root.has-repositories: Text {
                text: "No repositories configured or found.";
                color: #7a828e;
                font-size: 12px;
            }

            if root.reachable && root.error == "" && root.has-repositories && root.backups.length == 0: Text {
                text: "No snapshots found in repository: " + root.resolved-repo;
                color: #7a828e;
                font-size: 12px;
            }

            ScrollView {
                VerticalLayout {
                    spacing: 12px;

                    for b in root.backups: BackupCard { b: b; }

                    if root.slm-policies.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Snapshot Lifecycle Policies"; color: #ddd; font-weight: 700; font-size: 13px; }
                        Rectangle {
                            background: #181c22;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #2a2f38;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                for p in root.slm-policies: HorizontalLayout {
                                    height: 24px;
                                    spacing: 12px;
                                    Text { text: p.name; color: white; font-size: 11.5px; width: 160px; vertical-alignment: center; }
                                    Text { text: "Last: " + p.last-run; color: #999; font-size: 10.5px; vertical-alignment: center; }
                                    Text { text: "Next: " + p.next-run; color: #999; font-size: 10.5px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
