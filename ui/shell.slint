import { CheckBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { ClusterCard, DashboardOverview } from "dashboard.slint";
import { PresetCategory, VariablePair, HistoryEntry, SavedQueryItem, PresetItem, ConsoleScreen } from "console.slint";
import { NodeRow, AllocationRow, StatusScreen } from "status.slint";
import { MonitorRow, ObservabilityScreen } from "observability.slint";
import { TaskRow, TasksScreen } from "tasks.slint";
import { BackupRow, SlmPolicyRow, SnapshotScreen } from "snapshot.slint";
import { DocRow, DiscoverScreen } from "discover.slint";
import { IndexRow, DataStreamRow, IndicesScreen } from "indices.slint";

export struct ClusterAlert {
    name: string,
    message: string,
}

export struct ClusterItem {
    name: string,
    checked: bool,
    visible: bool,
}

export enum NavItem {
    dashboard,
    status,
    observability,
    tasks,
    snapshot,
    discover,
    indices,
    console,
    pipeline-simulator,
    settings,
}

component AlertBar inherits Rectangle {
    in property <bool> alerting: false;
    in property <[ClusterAlert]> alerts: [];

    height: alerting ? 64px : 32px;
    background: alerting ? #4a1f1f : #1f2e22;
    animate height { duration: 150ms; easing: ease-in-out; }

    if !alerting: HorizontalLayout {
        alignment: center;
        Text {
            text: "✓ All clusters healthy";
            color: #7fdc9a;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    if alerting: HorizontalLayout {
        padding: 8px;
        spacing: 12px;

        // Mascot placeholder: swap for a real <image> per status once assets exist.
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            border-width: 3px;
            border-color: #ff6b6b;
            background: #3a2222;
            Text {
                text: "!";
                color: #ff6b6b;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        ScrollView {
            HorizontalLayout {
                spacing: 8px;
                for alert in alerts: Rectangle {
                    width: 220px;
                    border-radius: 6px;
                    background: #522;
                    border-width: 1px;
                    border-color: #ff6b6b;
                    VerticalLayout {
                        padding: 6px;
                        Text { text: alert.name; color: white; font-weight: 700; font-size: 13px; }
                        Text { text: alert.message; color: #ffb3b3; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

component FocusedClusters inherits VerticalLayout {
    in-out property <bool> collapsed: true;
    in property <[ClusterItem]> clusters: [];
    in property <string> filter-text: "";
    in property <int> checked-count: 0;
    callback toggle-collapsed();
    callback filter-changed(string);
    callback cluster-toggled(string, bool);

    spacing: 4px;
    vertical-stretch: 0;

    Rectangle {
        height: 28px;
        TouchArea {
            clicked => { toggle-collapsed(); }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            Text {
                text: collapsed ? "▸" : "▾";
                color: #999;
                vertical-alignment: center;
                width: 16px;
            }
            Text {
                text: "Focused clusters (" + checked-count + " of " + clusters.length + ")";
                color: #ccc;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    if !collapsed: VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        LineEdit {
            placeholder-text: "Filter clusters...";
            text: filter-text;
            edited(text) => { filter-changed(text); }
        }

        Rectangle {
            height: min(180px, clusters.length * 28px);
            clip: true;

            ScrollView {
                VerticalLayout {
                    for c in clusters: HorizontalLayout {
                        visible: c.visible;
                        height: c.visible ? 26px : 0px;
                        spacing: 6px;
                        CheckBox {
                            checked: c.checked;
                            toggled => { cluster-toggled(c.name, self.checked); }
                        }
                        Text {
                            text: c.name;
                            vertical-alignment: center;
                            color: #ddd;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    background: selected ? #2d3f52 : nav-area.has-hover ? #20262f : transparent;
    border-radius: 4px;

    nav-area := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: selected ? #7fc7ff : #ccc;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 12px;
    }
}

component NavGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 2px;
    vertical-stretch: 0;

    Text {
        text: title;
        color: #777;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }
}

component Sidebar inherits Rectangle {
    in property <[ClusterItem]> clusters: [];
    in-out property <bool> focused-collapsed: true;
    in property <string> cluster-filter-text: "";
    in property <int> focused-checked-count: 0;
    in property <NavItem> selected-nav: NavItem.dashboard;

    callback nav-selected(NavItem);
    callback cluster-toggled(string, bool);
    callback filter-changed(string);

    width: 230px;
    background: #181c22;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        NavButton {
            label: "Dashboard";
            selected: root.selected-nav == NavItem.dashboard;
            clicked => { root.nav-selected(NavItem.dashboard); }
        }

        Rectangle { height: 1px; background: #2a2f38; }

        FocusedClusters {
            clusters: root.clusters;
            collapsed <=> root.focused-collapsed;
            filter-text: root.cluster-filter-text;
            checked-count: root.focused-checked-count;
            cluster-toggled(name, checked) => { root.cluster-toggled(name, checked); }
            filter-changed(text) => { root.filter-changed(text); }
            toggle-collapsed => { root.focused-collapsed = !root.focused-collapsed; }
        }

        Rectangle { height: 1px; background: #2a2f38; }

        NavGroup {
            title: "MONITOR";
            NavButton {
                label: "Status";
                selected: root.selected-nav == NavItem.status;
                clicked => { root.nav-selected(NavItem.status); }
            }
            NavButton {
                label: "Observability";
                selected: root.selected-nav == NavItem.observability;
                clicked => { root.nav-selected(NavItem.observability); }
            }
        }

        NavGroup {
            title: "OPERATE";
            NavButton {
                label: "Tasks";
                selected: root.selected-nav == NavItem.tasks;
                clicked => { root.nav-selected(NavItem.tasks); }
            }
            NavButton {
                label: "Snapshot";
                selected: root.selected-nav == NavItem.snapshot;
                clicked => { root.nav-selected(NavItem.snapshot); }
            }
        }

        NavGroup {
            title: "EXPLORE";
            NavButton {
                label: "Discover";
                selected: root.selected-nav == NavItem.discover;
                clicked => { root.nav-selected(NavItem.discover); }
            }
            NavButton {
                label: "Indices";
                selected: root.selected-nav == NavItem.indices;
                clicked => { root.nav-selected(NavItem.indices); }
            }
            NavButton {
                label: "Console";
                selected: root.selected-nav == NavItem.console;
                clicked => { root.nav-selected(NavItem.console); }
            }
            NavButton {
                label: "Pipeline Simulator";
                selected: root.selected-nav == NavItem.pipeline-simulator;
                clicked => { root.nav-selected(NavItem.pipeline-simulator); }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle { height: 1px; background: #2a2f38; }

        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                Text { text: "◷"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { horizontal-stretch: 1; }
            NavButton {
                width: 90px;
                label: "Settings";
                selected: root.selected-nav == NavItem.settings;
                clicked => { root.nav-selected(NavItem.settings); }
            }
        }
    }
}

export component AppShell inherits Window {
    title: "DRASTIC SMURF";
    width: 1280px;
    height: 800px;
    background: #10131a;

    in property <bool> alerting: false;
    in property <[ClusterAlert]> alerts: [];
    in property <[ClusterItem]> clusters: [];
    in-out property <bool> focused-collapsed: true;
    in property <string> cluster-filter-text: "";
    in property <int> focused-checked-count: 0;
    in-out property <NavItem> selected-nav: NavItem.dashboard;
    in property <[ClusterCard]> dashboard-cards: [];
    in property <int> dashboard-hidden-count: 0;

    in property <[string]> focused-cluster-names: [];
    in-out property <string> console-active-cluster: "";
    in property <int> console-workspace-tab: 0;
    in property <[PresetCategory]> console-preset-categories: [];
    in property <[VariablePair]> console-variables: [];
    in property <[HistoryEntry]> console-history: [];
    in property <[SavedQueryItem]> console-saved-queries: [];
    in property <bool> console-show-save-dialog: false;
    in property <string> console-save-name: "";
    in-out property <string> console-method: "GET";
    in-out property <string> console-path: "";
    in-out property <string> console-body: "";
    in property <string> console-response: "";
    in property <bool> console-is-loading: false;
    in-out property <bool> console-use-kibana: false;

    in-out property <string> status-active-cluster: "";
    in property <bool> status-connected: false;
    in property <string> status-error: "";
    in property <string> status-status: "";
    in property <string> status-es-version: "";
    in property <string> status-kibana-version: "";
    in property <int> status-nodes: 0;
    in property <int> status-data-nodes: 0;
    in property <int> status-active-shards: 0;
    in property <int> status-primary-shards: 0;
    in property <int> status-unassigned-shards: 0;
    in property <string> status-docs-human: "";
    in property <string> status-store-human: "";
    in property <[NodeRow]> status-node-rows: [];
    in property <[AllocationRow]> status-allocation-rows: [];

    callback status-active-cluster-changed(string);

    in-out property <string> obs-active-cluster: "";
    in-out property <string> obs-space-id: "default";
    in property <int> obs-workspace-tab: 0;
    in property <string> obs-filter-text: "";
    in property <bool> obs-is-loading: false;
    in property <string> obs-error: "";
    in property <[MonitorRow]> obs-monitors: [];
    in property <[MonitorRow]> obs-pinned-monitors: [];

    callback obs-active-cluster-changed(string);
    callback obs-space-changed(string);
    callback obs-space-apply();
    callback obs-workspace-tab-changed(int);
    callback obs-filter-changed(string);
    callback obs-refresh-clicked();
    callback obs-pin-toggled(string, bool);

    in-out property <string> tasks-active-cluster: "";
    in property <string> tasks-filter-text: "";
    in property <[string]> tasks-categories: ["All"];
    in property <string> tasks-selected-category: "All";
    in property <[TaskRow]> tasks-rows: [];
    in property <string> tasks-error: "";
    in property <bool> tasks-is-loading: false;

    callback tasks-active-cluster-changed(string);
    callback tasks-filter-changed(string);
    callback tasks-category-changed(string);
    callback tasks-task-toggle-expanded(string);
    callback tasks-refresh-clicked();

    in-out property <string> snapshot-active-cluster: "";
    in property <bool> snapshot-reachable: false;
    in property <string> snapshot-error: "";
    in property <bool> snapshot-has-repositories: false;
    in property <string> snapshot-resolved-repo: "";
    in property <[BackupRow]> snapshot-backups: [];
    in property <[SlmPolicyRow]> snapshot-slm-policies: [];
    in property <bool> snapshot-is-loading: false;

    callback snapshot-active-cluster-changed(string);
    callback snapshot-refresh-clicked();

    in-out property <string> discover-active-cluster: "";
    in-out property <string> discover-index-pattern: "logs-elasticsearch*";
    in-out property <string> discover-search-query: "";
    in property <int> discover-time-preset: 1;
    in property <[DocRow]> discover-results: [];
    in property <string> discover-error: "";
    in property <bool> discover-is-loading: false;

    callback discover-active-cluster-changed(string);
    callback discover-time-preset-changed(int);
    callback discover-search-clicked();
    callback discover-doc-toggle-expanded(string);

    in-out property <string> indices-active-cluster: "";
    in property <int> indices-active-tab: 0;
    in property <string> indices-filter-text: "";
    in property <bool> indices-only-selected: false;
    in property <int> indices-selected-count: 0;
    in property <string> indices-sort-field: "name";
    in property <bool> indices-sort-descending: false;
    in property <[IndexRow]> indices-rows: [];
    in property <[DataStreamRow]> indices-datastream-rows: [];
    in property <string> indices-error: "";
    in property <bool> indices-is-loading: false;

    callback indices-active-cluster-changed(string);
    callback indices-tab-changed(int);
    callback indices-filter-changed(string);
    callback indices-only-selected-toggled();
    callback indices-sort-changed(string);
    callback indices-index-checked(string, bool);
    callback indices-datastream-checked(string, bool);
    callback indices-refresh-clicked();

    callback cluster-toggled(string, bool);
    callback filter-changed(string);
    callback console-active-cluster-changed(string);
    callback console-workspace-tab-changed(int);
    callback console-category-toggled(string);
    callback console-preset-selected(PresetItem);
    callback console-variable-changed(int, string, string);
    callback console-variable-added();
    callback console-variable-removed(int);
    callback console-history-selected(int);
    callback console-history-cleared();
    callback console-saved-selected(int);
    callback console-saved-deleted(int);
    callback console-save-dialog-opened();
    callback console-save-name-changed(string);
    callback console-save-confirmed();
    callback console-save-cancelled();
    callback console-send-clicked();

    VerticalLayout {
        AlertBar {
            alerting: root.alerting;
            alerts: root.alerts;
        }

        HorizontalLayout {
            Sidebar {
                clusters: root.clusters;
                focused-collapsed <=> root.focused-collapsed;
                cluster-filter-text: root.cluster-filter-text;
                focused-checked-count: root.focused-checked-count;
                selected-nav <=> root.selected-nav;
                cluster-toggled(name, checked) => { root.cluster-toggled(name, checked); }
                filter-changed(text) => { root.filter-changed(text); }
                nav-selected(item) => { root.selected-nav = item; }
            }

            if root.selected-nav == NavItem.dashboard: DashboardOverview {
                horizontal-stretch: 1;
                cards: root.dashboard-cards;
                hidden-count: root.dashboard-hidden-count;
                expand-focused-clusters => { root.focused-collapsed = false; }
            }

            if root.selected-nav == NavItem.console: ConsoleScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.console-active-cluster;
                workspace-tab: root.console-workspace-tab;
                preset-categories: root.console-preset-categories;
                variables: root.console-variables;
                history: root.console-history;
                saved-queries: root.console-saved-queries;
                show-save-dialog: root.console-show-save-dialog;
                save-name: root.console-save-name;
                method <=> root.console-method;
                path <=> root.console-path;
                body <=> root.console-body;
                response: root.console-response;
                is-loading: root.console-is-loading;
                use-kibana <=> root.console-use-kibana;
                active-cluster-changed(v) => { root.console-active-cluster-changed(v); }
                workspace-tab-changed(t) => { root.console-workspace-tab-changed(t); }
                category-toggled(name) => { root.console-category-toggled(name); }
                preset-selected(item) => { root.console-preset-selected(item); }
                variable-changed(i, k, v) => { root.console-variable-changed(i, k, v); }
                variable-added => { root.console-variable-added(); }
                variable-removed(i) => { root.console-variable-removed(i); }
                history-selected(i) => { root.console-history-selected(i); }
                history-cleared => { root.console-history-cleared(); }
                saved-selected(i) => { root.console-saved-selected(i); }
                saved-deleted(i) => { root.console-saved-deleted(i); }
                save-dialog-opened => { root.console-save-dialog-opened(); }
                save-name-changed(t) => { root.console-save-name-changed(t); }
                save-confirmed => { root.console-save-confirmed(); }
                save-cancelled => { root.console-save-cancelled(); }
                send-clicked => { root.console-send-clicked(); }
            }

            if root.selected-nav == NavItem.status: StatusScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.status-active-cluster;
                connected: root.status-connected;
                error: root.status-error;
                status: root.status-status;
                es-version: root.status-es-version;
                kibana-version: root.status-kibana-version;
                nodes: root.status-nodes;
                data-nodes: root.status-data-nodes;
                active-shards: root.status-active-shards;
                primary-shards: root.status-primary-shards;
                unassigned-shards: root.status-unassigned-shards;
                docs-human: root.status-docs-human;
                store-human: root.status-store-human;
                node-rows: root.status-node-rows;
                allocation-rows: root.status-allocation-rows;
                active-cluster-changed(v) => { root.status-active-cluster-changed(v); }
            }

            if root.selected-nav == NavItem.observability: ObservabilityScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.obs-active-cluster;
                space-id <=> root.obs-space-id;
                workspace-tab: root.obs-workspace-tab;
                filter-text: root.obs-filter-text;
                is-loading: root.obs-is-loading;
                error: root.obs-error;
                monitors: root.obs-monitors;
                pinned-monitors: root.obs-pinned-monitors;
                active-cluster-changed(v) => { root.obs-active-cluster-changed(v); }
                space-changed(t) => { root.obs-space-changed(t); }
                space-apply => { root.obs-space-apply(); }
                workspace-tab-changed(t) => { root.obs-workspace-tab-changed(t); }
                filter-changed(t) => { root.obs-filter-changed(t); }
                refresh-clicked => { root.obs-refresh-clicked(); }
                pin-toggled(id, p) => { root.obs-pin-toggled(id, p); }
            }

            if root.selected-nav == NavItem.tasks: TasksScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.tasks-active-cluster;
                filter-text: root.tasks-filter-text;
                categories: root.tasks-categories;
                selected-category: root.tasks-selected-category;
                tasks: root.tasks-rows;
                error: root.tasks-error;
                is-loading: root.tasks-is-loading;
                active-cluster-changed(v) => { root.tasks-active-cluster-changed(v); }
                filter-changed(t) => { root.tasks-filter-changed(t); }
                category-changed(c) => { root.tasks-category-changed(c); }
                task-toggle-expanded(key) => { root.tasks-task-toggle-expanded(key); }
                refresh-clicked => { root.tasks-refresh-clicked(); }
            }

            if root.selected-nav == NavItem.snapshot: SnapshotScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.snapshot-active-cluster;
                reachable: root.snapshot-reachable;
                error: root.snapshot-error;
                has-repositories: root.snapshot-has-repositories;
                resolved-repo: root.snapshot-resolved-repo;
                backups: root.snapshot-backups;
                slm-policies: root.snapshot-slm-policies;
                is-loading: root.snapshot-is-loading;
                active-cluster-changed(v) => { root.snapshot-active-cluster-changed(v); }
                refresh-clicked => { root.snapshot-refresh-clicked(); }
            }

            if root.selected-nav == NavItem.discover: DiscoverScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.discover-active-cluster;
                index-pattern <=> root.discover-index-pattern;
                search-query <=> root.discover-search-query;
                time-preset: root.discover-time-preset;
                results: root.discover-results;
                error: root.discover-error;
                is-loading: root.discover-is-loading;
                active-cluster-changed(v) => { root.discover-active-cluster-changed(v); }
                time-preset-changed(p) => { root.discover-time-preset-changed(p); }
                search-clicked => { root.discover-search-clicked(); }
                doc-toggle-expanded(key) => { root.discover-doc-toggle-expanded(key); }
            }

            if root.selected-nav == NavItem.indices: IndicesScreen {
                horizontal-stretch: 1;
                cluster-options: root.focused-cluster-names;
                active-cluster <=> root.indices-active-cluster;
                active-tab: root.indices-active-tab;
                filter-text: root.indices-filter-text;
                only-selected: root.indices-only-selected;
                selected-count: root.indices-selected-count;
                sort-field: root.indices-sort-field;
                sort-descending: root.indices-sort-descending;
                indices: root.indices-rows;
                datastreams: root.indices-datastream-rows;
                error: root.indices-error;
                is-loading: root.indices-is-loading;
                active-cluster-changed(v) => { root.indices-active-cluster-changed(v); }
                tab-changed(t) => { root.indices-tab-changed(t); }
                filter-changed(t) => { root.indices-filter-changed(t); }
                only-selected-toggled => { root.indices-only-selected-toggled(); }
                sort-changed(f) => { root.indices-sort-changed(f); }
                index-checked(name, c) => { root.indices-index-checked(name, c); }
                datastream-checked(name, c) => { root.indices-datastream-checked(name, c); }
                refresh-clicked => { root.indices-refresh-clicked(); }
            }

            if root.selected-nav != NavItem.dashboard && root.selected-nav != NavItem.console && root.selected-nav != NavItem.status && root.selected-nav != NavItem.observability && root.selected-nav != NavItem.tasks && root.selected-nav != NavItem.snapshot && root.selected-nav != NavItem.discover && root.selected-nav != NavItem.indices: Rectangle {
                background: #14181f;
                horizontal-stretch: 1;
                Text {
                    text: "Content area";
                    color: #666;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
